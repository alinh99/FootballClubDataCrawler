# Football Club Data Crawler - Environment Variables
# Copy this to .env and fill in your API keys

# API Endpoints (discovered from website JavaScript bundles)
API_CLUB_RECOMMENDATION_URL = "https://hcdeapimngt1.azure-api.net/discoverfootball-subky/v1/api/clubandcasualrecommendation"
API_CLUB_INFO_URL = "https://hcdeapimngt1.azure-api.net/discoverfootball-subky/v1/api/club"
API_CLUB_CONTACT_URL = "https://hcdeapimngt1.azure-api.net/external/v1/orgs"

# API Subscription Keys (required for v3/v4 production)
# Get these from the API provider / Azure API Management
KEY_CLUB_INFO_AND_RECOMMENDATION_INFO =  ""
KEY_CLUB_CONTACT_INFO = ""

# Website Info
WEBSITE_URL = "https://find.englandfootball.com/"
WEBSITE_NAME = "EnglandFootballClub"

# Performance Settings
MAX_PROCESSES = 10
MAX_CONCURRENT_REQUESTS = 2000
MAX_CONCURRENT_LIMIT = 1000000000
BATCH_SAVE_SIZE = 200
RATE_LIMIT_SLEEP = 60

# Selenium Settings (for v5)
SELENIUM_HEADLESS = false
SELENIUM_TIMEOUT = 30
SELENIUM_IMPLICIT_WAIT = 10

# ⚠️ NOTE: The production API currently returns NO DATA (0 clubs for all cities).
# This is an API/provider issue. Use v5 (Selenium) for actual data collection.
# The v4 code is ready and correct — it will work when API data is restored.